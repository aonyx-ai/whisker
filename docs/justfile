# Run all recipes inside the Flox environment
set shell := ["flox", "activate", "--", "sh", "-cu"]

[private]
default:
    @just --list

# Install the site's dependencies, when they are missing or out of date
install:
    if [ ! -f node_modules/.package-lock.json ] || [ package-lock.json -nt node_modules/.package-lock.json ]; then npm ci; fi

# Create a static build of the site
build: install
    npm run build

# Start the local development server and open the site in the browser
dev: install
    npm run start
